
services:

  backend:
    build:
      context: ./server
    container_name: interviewiq-backend
    ports:
      - "8000:8000"
    env_file:
      - ./server/.env
    restart: unless-stopped

  frontend:
    build:
      context: ./client
    container_name: interviewiq-frontend
    ports:
      - "5173:80"
    depends_on:
      - backend
    restart: unless-stopped
